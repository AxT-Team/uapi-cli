{
  "name": "uapi-cli",
  "version": "0.1.1",
  "author": "UAPI",
  "description": "LLM-first UAPI CLI with prebuilt Go binaries and npm DX",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxT-Team/uapi-cli.git"
  },
  "homepage": "https://github.com/AxT-Team/uapi-cli#readme",
  "bugs": {
    "url": "https://github.com/AxT-Team/uapi-cli/issues"
  },
  "bin": {
    "uapi": "bin/uapi.js"
  },
  "files": [
    "bin",
    "README.md",
    "package.json",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "uapi-cli-darwin-arm64": "0.1.1",
    "uapi-cli-darwin-x64": "0.1.1",
    "uapi-cli-linux-arm64": "0.1.1",
    "uapi-cli-linux-x64": "0.1.1",
    "uapi-cli-win32-x64": "0.1.1"
  },
  "scripts": {
    "build:release": "node ./scripts/build-release.mjs",
    "build:local": "node ./scripts/build-local.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
